{
  "name": "engineering-reader",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "prebuild": "pnpm validate",
    "postbuild": "node -e \"require('fs').rmSync('public/pagefind',{recursive:true,force:true})\" && pagefind --site .next/server/app --output-path public/pagefind",
    "check:index": "node scripts/check-index.mjs",
    "check:search": "node scripts/check-search.mjs",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "validate": "tsx scripts/validate-content.ts",
    "render-mermaid": "tsx scripts/render-mermaid.ts"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "gray-matter": "^4.0.3",
    "next": "16.4.2",
    "next-mdx-remote": "^6.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rehype-pretty-code": "^0.14.5",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "shiki": "^4.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^12.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "jsdom": "^30.1.3",
    "pagefind": "1.5.2",
    "puppeteer": "25.14.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@11.1.1",
  "type": "module",
  "pnpm": {
    "onlyBuiltDependencies": [
      "puppeteer"
    ]
  }
}
